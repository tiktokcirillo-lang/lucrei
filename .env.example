VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
ANTHROPIC_API_KEY=

# Server only: configure as sensitive variables in Vercel. Never prefix with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS_JSON=
APP_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false in local/staging. A live key is rejected unless this is explicitly true.
STRIPE_LIVE_MODE=false
BILLING_ENABLED=false
LEGAL_APPROVED=false
# Object keyed by plan id. Each entry needs name, priceId and scans (integer >= 0).
BILLING_PLANS_JSON={}
# Global cap on AI attempts. Zero keeps receipt processing disabled.
AI_GLOBAL_MONTHLY_LIMIT=0
# Used only by the bootstrap script. false explicitly allows a free pilot.
REQUIRE_SUBSCRIPTION=true
